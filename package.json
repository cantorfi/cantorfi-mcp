{
  "name": "cantorfi-mcp",
  "version": "0.6.0",
  "description": "The CantorFi agent: one agent with its own wallet for CantorFi and every application built on it (lending, x402 payments in USDC, ICARE predictions and tribunal, Sjothr raises), plus the MCP bridge to the CantorFi door.",
  "mcpName": "io.github.cantorfi/cantorfi-mcp",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cantorfi-mcp": "src/bridge.mjs",
    "cantorfi-agent": "src/agent/cli.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/bridge.mjs",
    "agent": "node src/agent/cli.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantorfi/cantorfi-mcp.git"
  },
  "homepage": "https://www.cantorfi.xyz",
  "keywords": [
    "agent",
    "ai-agents",
    "base",
    "cantorfi",
    "defi",
    "isolated-lending",
    "lending",
    "liquidation",
    "mcp",
    "model-context-protocol",
    "usdc",
    "x402"
  ],
  "dependencies": {
    "@x402/core": "2.19.0",
    "ethers": "6.17.0"
  }
}
